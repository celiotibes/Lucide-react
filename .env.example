# ============================================================================
# PLATAFORMAS - NOVAS INTEGRAÇÕES
# ============================================================================

# Hospeda.com (STR Brasil)
HOSPEDA_API_KEY=xxx
HOSPEDA_WEBHOOK_SECRET=yyy
HOSPEDA_WEBHOOK_URL=https://seu-dominio/webhooks/hospeda

# Booking.com Apartments
# Nota: USA MESMA API KEY DO BOOKING HOTELS MAS COM PERMISSÃO /v2/apartments
BOOKING_API_KEY=xxx

# TripAdvisor Rentals
TRIPADVISOR_API_KEY=xxx

# ============================================================================
# WORKERS - FILAS DE SINCRONIZAÇÃO
# ============================================================================

# Scheduler de syncronizações (cron format)
SYNC_HOSPEDA_SCHEDULE=0 */6 * * * # A cada 6 horas
SYNC_BOOKING_APARTMENTS_SCHEDULE=0 */6 * * * * 
SYNC_TRIPADVISOR_RATINGS_SCHEDULE=0 */24 * * * # Daily

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# Enable structured logging (JSON format for production)
LOG_FORMAT=text

# Log retention period in days (for file-based logging)
LOG_RETENTION_DAYS=7

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Ativar/desativar plataformas
ENABLE_HOSPEDA_SYNC=true
ENABLE_BOOKING_APARTMENTS_SYNC=true
ENABLE_TRIPADVISOR_RATINGS_SYNC=true

# ============================================================================
# BI MODULE - BUSINESS INTELLIGENCE
# ============================================================================

# Base URL for BI API (frontend consumption)
REACT_APP_API_URL=http://localhost:3000/api

# JWT configuration for authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d

# Redis cache configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database configuration for BI Star Schema
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lucide_bi
DB_USER=postgres
DB_PASSWORD=

# BI-specific cache TTLs (in seconds)
CACHE_KPI_TTL=3600
CACHE_MOVEMENTS_TTL=1800
CACHE_REPORTS_TTL=7200

# Worker configuration for financial sync
WORKER_CONCURRENCY=5
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_DELAY=2000

# Financial data sync scheduling (cron format)
SYNC_FINANCIAL_REPORTING_SCHEDULE=0 2 * * *

# Email configuration for alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=admin@example.com

