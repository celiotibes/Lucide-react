# Copie para .env.local e preencha com valores reais. Nunca commitar .env.local.

# Connection string do Postgres (Supabase: Settings > Database > Connection
# string). Em produção, use a connection string com a service role — o
# back-office (app/imoveis, app/contratos, app/faturas) consulta o banco
# diretamente pelo servidor, sem passar por RLS (ver server/integracao/db.ts).
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Usados por lib/supabase/client.ts e lib/supabase/server.ts (Supabase Auth
# + Realtime): portal do prestador/investidor, módulo BI e qualquer tela que
# dependa de sessão de usuário logado ou de RLS. Pegue em Supabase:
# Settings > API > Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
