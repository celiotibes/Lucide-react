# ===================================
# CLIENTE (Vite, prefixo VITE_)
# ===================================

# Classificação automática com IA — documentos que a heurística não consegue classificar

# Opção 1: Backend endpoint (recomendado para produção)
# Seu servidor Node.js/Python/etc que recebe {texto} e retorna {tipo?, nomeContraparte?, confianca?, explicacao?}
# VITE_CLASIFICACAO_BACKEND=https://seu-backend.com/api/classificar

# Opção 2: API key Claude local (desenvolvimento/demo apenas)
# ⚠️ NUNCA commitar chave API real no repositório
# Gere uma chave em https://console.anthropic.com
# Validade: use em .env.local (gitignored) ou variável de ambiente na CI/build
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Se ambos estiverem vazios: graceful degradation — o sistema continua funcionando
# com heurística apenas (sem IA), tipo/fornecedor ficam indefinidos quando não há
# palavras-chave reconhecíveis, e o usuário preenche manualmente.

# Nome (@username) do bot do Telegram usado na captura rápida de documentos — ver
# CapturasTelegramView.tsx. Pública (prefixo VITE_, vai pro bundle) — NUNCA o token
# do bot (TELEGRAM_BOT_TOKEN), que fica só no .env do servidor.
# VITE_TELEGRAM_BOT_USERNAME=NomeDoSeuBot

# ===================================
# SERVIDOR (Node.js, prefixo nenhum)
# ===================================

# Asaas Payments API — Pagamentos PIX Proativos (Phase 5)
# Documentação: https://docs.asaas.com/reference/criar-pagamento
# Gere uma chave em https://app.asaas.com/settings/api (produção) ou sandbox
#
# ASAAS_API_KEY=your_api_key_here
# ASAAS_SANDBOX=true          # Use true para sandbox, false para produção (recomendado: true em dev)
# ASAAS_BASE_URL (opcional)   # Defina manualmente se diferente de sandbox/produção defaults
