# ============================================================================
# PLATAFORMAS - NOVAS INTEGRAÇÕES
# ============================================================================

# Hospeda.com (STR Brasil)
HOSPEDA_API_KEY=xxx
HOSPEDA_WEBHOOK_SECRET=yyy
HOSPEDA_WEBHOOK_URL=https://seu-dominio/webhooks/hospeda

# Booking.com Apartments
# Nota: USA MESMA API KEY DO BOOKING HOTELS MAS COM PERMISSÃO /v2/apartments
BOOKING_API_KEY=xxx

# TripAdvisor Rentals
TRIPADVISOR_API_KEY=xxx

# ============================================================================
# WORKERS - FILAS DE SINCRONIZAÇÃO
# ============================================================================

# Scheduler de syncronizações (cron format)
SYNC_HOSPEDA_SCHEDULE=0 */6 * * * # A cada 6 horas
SYNC_BOOKING_APARTMENTS_SCHEDULE=0 */6 * * * * 
SYNC_TRIPADVISOR_RATINGS_SCHEDULE=0 */24 * * * # Daily

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Ativar/desativar plataformas
ENABLE_HOSPEDA_SYNC=true
ENABLE_BOOKING_APARTMENTS_SYNC=true
ENABLE_TRIPADVISOR_RATINGS_SYNC=true

