# Copie para .env.local e preencha com valores reais. Nunca commitar .env.local.

# Connection string do Postgres (Supabase: Settings > Database > Connection
# string). Em produção, use a connection string com a service role — o
# back-office (app/imoveis, app/contratos, app/faturas) consulta o banco
# diretamente pelo servidor, sem passar por RLS (ver server/integracao/db.ts).
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Usados por lib/supabase/client.ts e lib/supabase/server.ts (Supabase Auth
# + Realtime): portal do prestador/investidor, módulo BI e qualquer tela que
# dependa de sessão de usuário logado ou de RLS. Pegue em Supabase:
# Settings > API > Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usada por lib/supabase/serviceClient.ts — bypassa RLS, mesmo raciocínio do
# DATABASE_URL acima, mas para operações de Storage (que não têm equivalente
# via conexão Postgres direta). Pegue em Supabase: Settings > API >
# service_role key (secreta — NUNCA exponha com prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# Chamadas reais de IA (server/ai-gateway/providers/claudeProvider.ts) —
# leitura de contrato anexado, redação de documento jurídico. Pegue em
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=sua-chave-anthropic

# Destinatário interno dos avisos automáticos de calendário contratual
# (server/integracao/processarReequilibrioTrienal.ts,
# processarRenovacaoContratual.ts) — reequilíbrio trienal e renovação.
# Opcional: se ausente, usa admin@crmt.dev.
EMAIL_ADMIN_NOTIFICACOES=admin@seudominio.com.br
