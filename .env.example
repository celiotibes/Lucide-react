# ============================================================================
# Environment Configuration Template
# Arquivo: .env.example
#
# Como usar:
# 1. Copiar este arquivo: cp .env.example .env
# 2. Substituir os valores marcados com "CHANGE_ME_" pelos valores reais
# 3. NÃO fazer commit do .env (está em .gitignore)
# 4. Compartilhar variáveis necessárias em documentação privada
#
# ============================================================================

# ============================================================================
# 1. AMBIENTE
# ============================================================================

# Ambiente de execução (development, staging, production)
NODE_ENV=development

# Port da aplicação (padrão: 3000)
API_PORT=3000

# Host da aplicação (padrão: localhost)
API_HOST=localhost

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# ============================================================================
# 2. BANCO DE DADOS (PostgreSQL)
# ============================================================================

# Connection string PostgreSQL
# Formato: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
# Exemplo local: postgresql://rental_user:password@localhost:5432/rental_sync
# Exemplo produção: postgresql://rental_user:STRONG_PASSWORD@prod-postgres.xxx.rds.amazonaws.com:5432/rental_sync
DATABASE_URL=postgresql://rental_user:CHANGE_ME_DB_PASSWORD@localhost:5432/rental_sync

# Pool de conexões
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_QUERY_TIMEOUT=30000

# Replica para leitura (opcional, produção)
# Deixar em branco para desabilitar
DATABASE_REPLICA_URL=

# ============================================================================
# 3. CACHE (Redis)
# ============================================================================

# Connection string Redis
# Formato: redis://[:password@]host[:port][/db]
# Exemplo: redis://localhost:6379/0
# Com senha: redis://:STRONG_PASSWORD@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# TTL padrão para cache (segundos)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_LISTINGS=1800
CACHE_TTL_PRICING=900
CACHE_TTL_LEADS=1800

# ============================================================================
# 4. AUTENTICAÇÃO & SEGURANÇA
# ============================================================================

# JWT Secret (deve ser aleatório, mínimo 32 caracteres)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_LONG

# JWT expiration (segundos, padrão: 86400 = 24h)
JWT_EXPIRY=86400

# Refresh token expiration (segundos, padrão: 604800 = 7 dias)
JWT_REFRESH_EXPIRY=604800

# CORS - origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.rental-sync.com

# ============================================================================
# 5. APIs EXTERNAS - PLATAFORMAS DE ALUGUEL
# ============================================================================

# Airbnb
AIRBNB_API_KEY=CHANGE_ME_AIRBNB_API_KEY
AIRBNB_API_BASE_URL=https://api.airbnb.com/v1
AIRBNB_SYNC_INTERVAL=3600

# Booking.com
BOOKING_API_KEY=CHANGE_ME_BOOKING_API_KEY
BOOKING_API_BASE_URL=https://api.booking.com/v1
BOOKING_SYNC_INTERVAL=3600

# VRBO (Expedia Group)
VRBO_API_KEY=CHANGE_ME_VRBO_API_KEY
VRBO_API_BASE_URL=https://api.vrbo.com/v1
VRBO_SYNC_INTERVAL=3600

# Google Gemini (AI para descriptions)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================================================
# 6. WORKERS E JOBS (BullMQ)
# ============================================================================

# Concorrência padrão de workers
WORKER_CONCURRENCY=10

# Tentativas de retry para jobs falhos
JOB_ATTEMPTS=3

# Delay inicial para retry (ms)
JOB_BACKOFF_DELAY=5000

# Enabled workers (comma-separated)
ENABLED_WORKERS=sync-listings,update-pricing,lead-management,analytics

# ============================================================================
# 7. NOTIFICAÇÕES
# ============================================================================

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME_SLACK_WEBHOOK
SLACK_CHANNEL=#notifications
SLACK_ENABLED=false

# Email (SMTP)
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@rental-sync.com
SMTP_FROM_NAME=Rental Sync
SMTP_TLS=true

# ============================================================================
# 8. ARMAZENAMENTO (AWS S3 / Google Cloud Storage)
# ============================================================================

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET
AWS_S3_BUCKET=rental-sync-data
AWS_S3_BACKUP_BUCKET=rental-sync-backups

# GCP Cloud Storage
GCP_PROJECT_ID=CHANGE_ME_GCP_PROJECT
GCP_STORAGE_BUCKET=rental-sync-data
GCP_BACKUP_BUCKET=rental-sync-backups

# ============================================================================
# 9. RATE LIMITING
# ============================================================================

# Rate limit por IP (requisições por minuto)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Rate limit específico para login (req/min)
LOGIN_RATE_LIMIT=10

# ============================================================================
# 10. MONITORAMENTO E OBSERVABILIDADE
# ============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=3000
PROMETHEUS_PATH=/metrics

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACING_SAMPLE_RATE=0.1

# ============================================================================
# 11. FEATURE FLAGS
# ============================================================================

# Ativar sincronização automática
SYNC_AUTO_ENABLED=true
SYNC_AUTO_INTERVAL=3600

# Ativar preços dinâmicos
DYNAMIC_PRICING_ENABLED=true

# Ativar webhooks
WEBHOOKS_ENABLED=true

# Ativar analytics
ANALYTICS_ENABLED=true

# ============================================================================
# 12. CONFIGURAÇÃO DE DESENVOLVIMENTO
# ============================================================================

# Debug mode (verbose logging, stack traces)
DEBUG=false

# Seed database com dados de teste
SEED_DATABASE=false

# Mock external APIs (não chamar APIs reais)
MOCK_EXTERNAL_APIS=false

# ============================================================================
# 13. CONFIGURAÇÃO DE PRODUÇÃO
# ============================================================================

# CDN URL para assets
CDN_URL=https://cdn.rental-sync.com

# Sentry Release version (autom. no CI/CD)
SENTRY_RELEASE=1.0.0

# ============================================================================
# 14. VARIÁVEIS OPCIONAIS (Kubernetes/Container)
# ============================================================================

# Namespace (Kubernetes)
KUBERNETES_NAMESPACE=rental-sync

# Service name (Kubernetes)
KUBERNETES_SERVICE_NAME=rental-sync-api

# Pod name
POD_NAME=

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. NUNCA fazer commit deste arquivo com valores reais
# 2. Em produção, usar Secret Manager (AWS Secrets Manager, Vault, etc)
# 3. Para desenvolvimento local, criar .env com valores de teste
# 4. Valores com "CHANGE_ME_" são obrigatórios para funcionamento
# 5. Valores em branco podem usar defaults definidos no código
# 6. Documentar novos valores de env aqui com comentários
# 7. Validar presença de secrets obrigatórios na inicialização da app
#
# Exemplo de validação no código:
# const requiredSecrets = ['JWT_SECRET', 'DATABASE_URL', 'REDIS_URL'];
# requiredSecrets.forEach(secret => {
#   if (!process.env[secret]) throw new Error(`Missing: ${secret}`);
# });

