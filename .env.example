# Configuração de Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha seus valores

# Claude API - Assistente IA Jurídico
# Obtenha sua chave em: https://console.anthropic.com
# Modelo: claude-opus-4-8 (mais poderoso) ou claude-sonnet-5 (mais rápido)
VITE_CLAUDE_API_KEY=sk-ant-xxxxx

# Google Drive (futuro para FASE 3D)
VITE_GOOGLE_DRIVE_API_KEY=your_oauth_key_here

# Legal Data Hunter (futuro para integração completa)
VITE_LEGAL_DATA_HUNTER_API_KEY=your_api_key_here

# Ambiente
VITE_ENVIRONMENT=development

# Logs (development, production, off)
VITE_LOG_LEVEL=development
