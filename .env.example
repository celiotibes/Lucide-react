# ===================================
# CLIENTE (Vite, prefixo VITE_)
# ===================================

# Classificação automática com IA — documentos que a heurística não consegue classificar

# Opção 1: Backend endpoint (recomendado para produção)
# Seu servidor Node.js/Python/etc que recebe {texto} e retorna {tipo?, nomeContraparte?, confianca?, explicacao?}
# VITE_CLASIFICACAO_BACKEND=https://seu-backend.com/api/classificar

# Opção 2: API key Claude local (desenvolvimento/demo apenas)
# ⚠️ NUNCA commitar chave API real no repositório
# Gere uma chave em https://console.anthropic.com
# Validade: use em .env.local (gitignored) ou variável de ambiente na CI/build
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Se ambos estiverem vazios: graceful degradation — o sistema continua funcionando
# com heurística apenas (sem IA), tipo/fornecedor ficam indefinidos quando não há
# palavras-chave reconhecíveis, e o usuário preenche manualmente.

# Nome (@username) do bot do Telegram usado na captura rápida de documentos — ver
# CapturasTelegramView.tsx. Pública (prefixo VITE_, vai pro bundle) — NUNCA o token
# do bot (TELEGRAM_BOT_TOKEN), que fica só no .env do servidor.
# VITE_TELEGRAM_BOT_USERNAME=NomeDoSeuBot

# ===================================
# SERVIDOR (Node.js, prefixo nenhum)
# ===================================

# Asaas Payments API — Pagamentos PIX Proativos (Phase 5)
# Documentação: https://docs.asaas.com/reference/criar-pagamento
# Gere uma chave em https://app.asaas.com/settings/api (produção) ou sandbox
#
# ASAAS_API_KEY=your_api_key_here
# ASAAS_SANDBOX=true          # Use true para sandbox, false para produção (recomendado: true em dev)
# ASAAS_BASE_URL (opcional)   # Defina manualmente se diferente de sandbox/produção defaults

# ===================================
# CACHE EM MEMÓRIA (Phase 9)
# ===================================
# TTLs para cache de relatórios (em milissegundos)
# Padrão: DRE 1h, Fluxo 2h, Margens 2h (significativo se tiver 1000+ lançamentos/mês)
#
# CACHE_TTL_DRE=3600000           # 1 hora
# CACHE_TTL_FLUXO=7200000         # 2 horas
# CACHE_TTL_MARGENS=7200000       # 2 horas
# CACHE_TTL_RECONCILIACAO=1800000 # 30 minutos

# ===================================
# ALERTAS POR EMAIL (Phase 9)
# ===================================
# Notificações automáticas quando scheduler falha (DRE, Reconciliação PIX, Pagamentos PIX)
# Fornecedor: "resend" (recomendado) | "sendgrid" | "none" (graceful degradation)
# Signup free tier: https://resend.com ou https://sendgrid.com (100 emails/dia)
#
# ALERTS_EMAIL_PROVIDER=resend
# ALERTS_EMAIL_API_KEY=sk-or_... (Resend) ou SG.xxx... (SendGrid)
# ALERTS_EMAIL_FROM=noreply@seu-dominio.com
# ALERTS_EMAIL_TO_ADMIN=admin@seu-dominio.com,gestor@seu-dominio.com

# ===================================
# ALERTAS VIA SLACK (Phase 9)
# ===================================
# Notificações em tempo real em canal privado #alertas-contabilidade
# Setup: Settings > Integrations > Incoming Webhooks > Add to #alertas-contabilidade
#
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXX

# ===================================
# SENTRY (SEC-012: Optional Error Tracking & Performance Monitoring)
# ===================================
# Monitoramento de erros e performance em produção ($9/mês ou gratuito para hobby)
# Signup: https://sentry.io
#
# Features:
# - Error tracking com contexto (API, operação, tags)
# - Performance monitoring (transações, spans)
# - Sensitive data filtering (API keys, tokens, PII)
# - Release tracking com sourcemaps
# - Breadcrumb trails para debugging
# - Amostragem: 10% em produção, 100% em desenvolvimento
#
# Setup:
# 1. Crie uma conta em https://sentry.io
# 2. Crie um novo projeto para Node.js
# 3. Cole o DSN abaixo (formato: https://key@host/projectId)
# 4. Em produção, configure traceSampleRate conforme carga esperada
# 5. (Opcional) Configure upload de sourcemaps na CI/CD para melhor debugging
#
# Se não configurar (vazio ou omitido), Sentry fica desabilitado (graceful degradation)
#
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ===================================
# GOOGLE DRIVE BACKUP (Agente 5)
# ===================================
#
# Backup automático do banco SQLite para Google Drive (a cada 1 hora)
# Documentação: https://cloud.google.com/docs/authentication/getting-started
#
# 1. Crie um Service Account em Google Cloud Console (https://console.cloud.google.com)
# 2. Gere uma chave privada em formato JSON
# 3. Cole o JSON COMPLETO abaixo (inclua quebras de linha)
# 4. Compartilhe a pasta do Drive com o email do service account
#
# Formato: JSON completo do service account (inclua \n para quebras de linha ou use multiline no .env.local)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"seu-projeto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...",...}
#
# Se não configurar, o backup é desabilitado (sistema continua funcionando sem Google Drive)

# ===================================
# BACKUP CRIPTOGRAFADO (Fase 13)
# ===================================
#
# Backup com 2+ cópias, criptografia AES-256-GCM, validação de integridade
# Local + Google Drive (offsite)
#
# 1. BACKUP_LOCAL_DIR: caminho local para armazenar backups criptografados
#    Exemplo: /mnt/backup, /nas/backups, /srv/backups
#    OBRIGATÓRIO
#
# 2. BACKUP_ENCRYPTION_KEY: chave AES-256 em hexadecimal (64 caracteres = 32 bytes)
#    Gerar: openssl rand -hex 32
#    OBRIGATÓRIO
#    ⚠️ NUNCA commitar a chave real no repositório!
#    ⚠️ NUNCA logar ou exibir a chave em logs!
#    Armazene em .env.local ou secrets do CI/CD
#
# Variáveis de Ambiente:
# BACKUP_LOCAL_DIR=/mnt/backup
# BACKUP_ENCRYPTION_KEY=abc123def456...
#
# CLI:
#   tsx server/src/scripts/backup.ts criar              # Criar novo backup
#   tsx server/src/scripts/backup.ts verificar          # Verificar integridade
#   tsx server/src/scripts/backup.ts testar-restauracao # Testar restauração
#   tsx server/src/scripts/backup.ts listar             # Listar backups
#
# Documentação: docs/BACKUP.md

# ===================================
# BACKUP SCHEDULER (Fase 13)
# ===================================
#
# Agendamento periódico de backups com verificação de integridade
# Roda em background (setInterval.unref()) sem bloquear saída do processo
#
# BACKUP_SCHEDULE: quando rodar backups (cron-like "HH MM" ou intervalo em minutos)
#                  Exemplos: "0 2 * * *" (2 AM diariamente), "1440" (24h)
#                  Padrão: "0 2 * * *"
#
# BACKUP_VERIFY_SCHEDULE: quando testar restauração (cron-like ou minutos)
#                         Exemplos: "0 3 * * 1" (3 AM segunda-feira), "10080" (7 dias)
#                         Padrão: "0 3 * * 1"
#
# BACKUP_RETENTION_DAYS: dias de retenção operacional (padrão: 7)
#
# BACKUP_FISCAL_RETENTION_DAYS: dias de retenção fiscal (padrão: 1825 = ~5 anos)
#                               Alguns países exigem 5+ anos de retenção
#
# NAS_PATH: caminho para copiar backups (ex: /mnt/nas/backups)
#           Se vazio, cópia NAS é desabilitada (apenas local + Google Drive)
#
# NAS_COPY_ENABLED: ativar cópia automática para NAS
#                   Padrão: false
#
# Exemplos:
# BACKUP_SCHEDULE=0 2 * * *              # 2 AM diariamente
# BACKUP_VERIFY_SCHEDULE=0 3 * * 1       # 3 AM segunda-feira
# BACKUP_RETENTION_DAYS=7                # Operacional: 7 dias
# BACKUP_FISCAL_RETENTION_DAYS=1825      # Fiscal: ~5 anos
# NAS_PATH=/mnt/nas/backups
# NAS_COPY_ENABLED=false

# ===================================
# WEBHOOK ASAAS (OBRIGATÓRIO em produção)
# ===================================
# Mesmo valor configurado no painel da Asaas (header `asaas-access-token`).
# Sem esta variável o endpoint /api/asaas/webhooks/asaas responde 503 e NÃO aceita eventos.
# Gerar: openssl rand -hex 32
# ASAAS_WEBHOOK_TOKEN=
