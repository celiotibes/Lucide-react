# Environment Configuration Template for Lucide React Mobile Application
# Copy this file to .env.local and fill in the actual values
# NEVER commit .env.local with real secrets to version control

# ============================================================================
# API Configuration
# ============================================================================
API_ENDPOINT=https://api.crmt.app
API_ENDPOINT_BACKUP=https://backup-api.crmt.app
API_TIMEOUT=30000

# ============================================================================
# Firebase Configuration
# ============================================================================
FIREBASE_API_KEY=AIzaSyD...your_firebase_api_key...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abc123def456
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============================================================================
# Certificate Pinning Configuration
# ============================================================================
# Generate certificate pins using: openssl s_client -servername api.crmt.app -connect api.crmt.app:443 | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64
API_CERT_PIN=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BACKUP_API_CERT_PIN=sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Alternative certificate pins for key rotation (backup)
API_CERT_PIN_BACKUP1=sha256/CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC=
API_CERT_PIN_BACKUP2=sha256/DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD=

# ============================================================================
# Encryption Configuration
# ============================================================================
# AES-256-GCM Encryption Key (32 bytes = 256 bits)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_encryption_key_base64_encoded_here
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_ITERATIONS=100000
ENCRYPTION_SALT_LENGTH=32
ENCRYPTION_IV_LENGTH=16

# ============================================================================
# JWT Token Configuration
# ============================================================================
# JWT Secret for signing tokens (optional, if backend shares it)
JWT_SECRET=your_jwt_secret_key_here
# Token expiration times (in seconds)
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800
# Token refresh buffer time (seconds before expiry to trigger refresh)
TOKEN_EXPIRY_BUFFER=300

# ============================================================================
# Biometric Authentication (Optional)
# ============================================================================
BIOMETRIC_AUTH_ENABLED=true
BIOMETRIC_AUTH_TYPE=fingerprint

# ============================================================================
# Privacy & Compliance Configuration
# ============================================================================
# Privacy Policy URLs
PRIVACY_POLICY_URL=https://crmt.app/privacy
TERMS_OF_SERVICE_URL=https://crmt.app/terms
DATA_PROTECTION_OFFICER_EMAIL=dpo@crmt.app

# GDPR Configuration
GDPR_ENABLED=true
GDPR_DATA_RETENTION_DAYS=365

# CCPA Configuration
CCPA_ENABLED=true
CCPA_CONSUMER_RIGHTS_URL=https://crmt.app/ccpa-rights

# LGPD Configuration (Brazil)
LGPD_ENABLED=true
LGPD_DATA_CONTROLLER_EMAIL=controller@crmt.app
LGPD_DATA_PROTECTION_OFFICER_EMAIL=dpo@crmt.app

# Data Deletion Configuration
AUTO_DELETE_AFTER_DAYS=365
DATA_DELETION_COMPLETION_DAYS=30

# ============================================================================
# Security Headers
# ============================================================================
# Content Security Policy
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;

# HSTS Configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ============================================================================
# Logging & Analytics Configuration
# ============================================================================
LOG_LEVEL=info
# Possible values: debug, info, warn, error, critical
# Never log: passwords, tokens, encryption keys, PII

# Firebase Analytics
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=100

# Crash Reporting
CRASH_REPORTING_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

# ============================================================================
# Apple App Store Configuration
# ============================================================================
APPLE_ID=your_apple_id@example.com
APPLE_ID_PASSWORD=your_app_specific_password
APPLE_TEAM_ID=ABCDEFGHIJ

# ============================================================================
# Google Play Store Configuration
# ============================================================================
# Use Google Play Console to generate service account JSON and base64 encode it
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# EAS (Expo Application Services) Configuration
# ============================================================================
EAS_PROJECT_ID=your_eas_project_id
EAS_ANALYTICS_TOKEN=your_eas_analytics_token

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_BIOMETRIC_AUTH=true
FEATURE_OFFLINE_MODE=true
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_DATA_EXPORT=true

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# ============================================================================
# Staging/Development Environment
# ============================================================================
STAGING_API_ENDPOINT=https://api.staging.crmt.app
STAGING_API_CERT_PIN=sha256/staging_pin_here

# Development/Debug Configuration
DEBUG_MODE=false
MOCK_API_RESPONSES=false
LOG_NETWORK_REQUESTS=false
LOG_ENCRYPTION_OPERATIONS=false

# ============================================================================
# Third-Party Services
# ============================================================================
# SMS/Email Service Provider
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# Email Service
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ============================================================================
# Session & Cookie Configuration
# ============================================================================
SESSION_TIMEOUT_MINUTES=30
REMEMBER_ME_DURATION_DAYS=7
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict

# ============================================================================
# Notes:
# 1. All secret values should be generated and stored securely
# 2. Use strong, unique values for all encryption and authentication keys
# 3. Rotate keys periodically (at least annually)
# 4. Store actual .env.local file in secure password manager
# 5. Never commit .env.local to version control
# 6. Different values needed for staging and production
# 7. Implement key rotation for certificate pins every 12 months
# ============================================================================
