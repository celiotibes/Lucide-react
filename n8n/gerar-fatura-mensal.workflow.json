{
  "name": "CRMT - Gerar Fatura Mensal",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 1 * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Todo dia 1 às 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CRMT_APP_URL}}/api/cron/gerar-fatura-mensal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.CRMT_CRON_SECRET}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "chamar-endpoint",
      "name": "Chamar /api/cron/gerar-fatura-mensal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.puladas.length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "tem-pulados",
      "name": "Algum contrato foi pulado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 300]
    }
  ],
  "connections": {
    "Todo dia 1 às 06:00": {
      "main": [[{ "node": "Chamar /api/cron/gerar-fatura-mensal", "type": "main", "index": 0 }]]
    },
    "Chamar /api/cron/gerar-fatura-mensal": {
      "main": [[{ "node": "Algum contrato foi pulado?", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
