        },
        {
          "name": "Delete Certificate",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/certificates/{{fingerprint}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "auth", "certificates", "{{fingerprint}}"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
