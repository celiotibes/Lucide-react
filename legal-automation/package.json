{
  "name": "legal-automation-tool",
  "version": "0.1.0",
  "description": "Automação para peticionar no eProc TJSC e Projudi TJPR",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:reset": "ts-node scripts/reset-db.ts",
    "prepare": "husky install"
  },
  "keywords": [
    "eproc",
    "projudi",
    "legal",
    "automation",
    "tjsc",
    "tjpr",
    "jurídico"
  ],
  "author": "celiotibes@gmail.com",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.3.0",
    "node-soap": "^1.0.0",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-http": "^8.5.1",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
