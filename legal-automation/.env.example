# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# JWT
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# DataJud API (CNJ)
DATAJUD_API_KEY=your_datajud_api_key
DATAJUD_API_URL=https://apipublica.cnj.jus.br/api/v2

# Projudi TJPR
PROJUDI_WSDL_URL=https://tst.tjpr.jus.br/projudi/webservices/projudiIntercomunicacaoWebService222?wsdl
PROJUDI_USERNAME=your_tjpr_username
PROJUDI_PASSWORD=your_tjpr_password

# eProc TJSC
EPROC_API_URL=https://eproc.tjsc.jus.br/api
EPROC_2FA_TIMEOUT=300

# Certificado Digital
CERT_STORAGE_PATH=./certs
CERT_ENCRYPTION_KEY=your_cert_encryption_key_change_in_production

# Database (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/legal_automation

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 2FA Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+5511999999999

# SMTP (para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@legal-automation.local

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
