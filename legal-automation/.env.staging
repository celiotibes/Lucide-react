# ===== Staging Environment Configuration =====
# This file contains staging-specific environment variables
# Use: docker-compose -f docker-compose.staging.yml --env-file .env.staging up

# Server
NODE_ENV=staging
PORT=3000
API_BASE_URL=http://api.staging.local:3000

# Database
DB_PASSWORD=staging_secure_password_change_before_deploy
DATABASE_URL=postgresql://legal_user:staging_secure_password_change_before_deploy@postgres:5432/legal_automation_staging

# Redis
REDIS_PASSWORD=staging_redis_password_secure

# JWT
JWT_SECRET=staging_jwt_secret_minimum_32_chars_change_production
JWT_EXPIRES_IN=24h

# DataJud API (Staging)
DATAJUD_API_KEY=staging_datajud_api_key
DATAJUD_API_URL=https://apipublica.cnj.jus.br/api/v2

# Projudi TJPR (Test Environment)
PROJUDI_WSDL_URL=https://tst.tjpr.jus.br/projudi/webservices/projudiIntercomunicacaoWebService222?wsdl
PROJUDI_USERNAME=staging_tjpr_username
PROJUDI_PASSWORD=staging_tjpr_password

# eProc TJSC (Staging)
EPROC_API_URL=https://eproc.tjsc.jus.br/api
EPROC_2FA_TIMEOUT=300

# TRF4 (Federal Court 4th Region - Staging)
TRF4_API_URL=https://portal-eproc.trf4.jus.br/eprocV2/
TRF4_LOGIN=staging_trf4_login
TRF4_PASSWORD=staging_trf4_password

# JFPR (Federal Justice Paraná - Staging)
JFPR_API_URL=https://eproc.jfpr.jus.br/api
JFPR_LOGIN=staging_jfpr_login
JFPR_PASSWORD=staging_jfpr_password

# Certificate
CERT_STORAGE_PATH=./certs
CERT_ENCRYPTION_KEY=staging_cert_encryption_key_minimum_32_chars

# SMTP (Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=staging-notifications@example.com
SMTP_PASS=staging_app_password
SMTP_FROM=noreply@legal-automation-staging.local

# Rate Limiting (Higher for load testing)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://api:3000,http://api.staging.local:3000

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ===== AI / LLM Configuration =====
AI_PRIMARY_MODEL=claude
AI_FALLBACK_MODELS=gemini
AI_OFFLINE_MODE=true
AI_CACHE_TTL=604800

# Claude API (Anthropic)
CLAUDE_API_KEY=sk-ant-your_staging_claude_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MODEL_HAIKU=claude-3-5-haiku-20241022

# Gemini (Google)
GEMINI_API_KEY=your_staging_gemini_key_here

# AI Service Config
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000
AI_ENABLE_RAG=false
AI_COST_BUDGET=100

# ===== TSA (Time Stamp Authority) Configuration =====
# Staging uses test TSA servers
TSA_PROVIDERS=sincronize,certinf,certisign
TSA_TIMEOUT_MS=5000
TSA_RETRY_MAX=3

# Sincronize TSA (Staging)
TSA_SINCRONIZE_URL=https://tst.tsa.sincronize.com.br:8080/sincronize/rest/timestamp
TSA_SINCRONIZE_USER=staging_user
TSA_SINCRONIZE_PASS=staging_pass

# Certinf TSA (Staging)
TSA_CERTINF_URL=https://tst.tsa.certinf.net/rest/timestamp
TSA_CERTINF_USER=staging_user
TSA_CERTINF_PASS=staging_pass

# Certisign TSA (Staging)
TSA_CERTISIGN_URL=https://tsa-staging.certisign.com.br/tsa/rest/timestamp
TSA_CERTISIGN_USER=staging_user
TSA_CERTISIGN_PASS=staging_pass

# ===== ICP-Brasil Configuration =====
ICP_BRASIL_ENABLED=true
ICP_BRASIL_TEST_MODE=true
ICP_BRASIL_CERT_CHAIN_VALIDATION=true

# ===== Notification Service =====
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WEBHOOK_ENABLED=false

# ===== Polling Service =====
PETITION_POLLING_INTERVAL_MS=300000
PETITION_POLLING_MAX_ATTEMPTS=12
PETITION_POLLING_TIMEOUT_MS=3600000

# ===== Analytics =====
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1.0

# ===== APM (Application Performance Monitoring) =====
APM_ENABLED=false
APM_SERVER_URL=http://apm-server.staging.local:8200
