# Production Environment - Free Tier (Render + Supabase)
NODE_ENV=production
PORT=3000
API_BASE_URL=https://legal-automation-prod.onrender.com

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-to-a-random-secure-32-char-string-in-production
JWT_EXPIRES_IN=24h

# Database - Set via Render environment variables
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@db.host:port/database

# Redis - DISABLED for free tier (optional fallback)
# REDIS_URL=redis://localhost:6379

# Elasticsearch - DISABLED for free tier
# ELASTICSEARCH_URL=http://localhost:9200

# Legal Platform APIs - Set via Render secrets
DATAJUD_API_KEY=your_datajud_api_key
DATAJUD_API_URL=https://apipublica.cnj.jus.br/api/v2

PROJUDI_WSDL_URL=https://tst.tjpr.jus.br/projudi/webservices/projudiIntercomunicacaoWebService222?wsdl
PROJUDI_USERNAME=your_tjpr_username
PROJUDI_PASSWORD=your_tjpr_password

EPROC_API_URL=https://eproc.tjsc.jus.br/api
EPROC_2FA_TIMEOUT=300

TRF4_API_URL=https://portal-eproc.trf4.jus.br/eprocV2/
TRF4_LOGIN=your_trf4_login
TRF4_PASSWORD=your_trf4_password

JFPR_API_URL=https://eproc.jfpr.jus.br/api
JFPR_LOGIN=your_jfpr_login
JFPR_PASSWORD=your_jfpr_password

JUST_API_URL=https://api.datajud.cnj.jus.br/api/v1
JUST_API_KEY=your_just_api_key

TJMT_API_URL=https://eproc.tjmt.jus.br/api
TJMT_LOGIN=your_tjmt_login
TJMT_PASSWORD=your_tjmt_password

TJRO_EPROC_API_URL=https://eproc.tjro.jus.br/api/v1
TJRO_PJE_API_URL=https://pje.tjro.jus.br/api
TJRO_LOGIN=your_tjro_login
TJRO_PASSWORD=your_tjro_password

TJPR_EPROC_API_URL=https://eproc-beta.tjpr.jus.br/api/v1

# Certificate Management
CERT_STORAGE_PATH=./certs
CERT_ENCRYPTION_KEY=change-this-to-a-random-secure-32-char-string-in-production

# Logging
LOG_LEVEL=info
LOG_FILE=/tmp/legal-automation.log

# 2FA Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+5511999999999

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@legal-automation.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://legal-automation-prod.onrender.com,https://yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/tmp/uploads

# AI / LLM Configuration
AI_PRIMARY_MODEL=claude
AI_FALLBACK_MODELS=gemini,grok,ollama
AI_OFFLINE_MODE=true
AI_CACHE_TTL=604800
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000
AI_ENABLE_RAG=false

# Claude (Anthropic) - Recommended for legal work
CLAUDE_API_KEY=your_claude_api_key_if_using_claude
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MODEL_HAIKU=claude-3-5-haiku-20241022

# Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_if_using_gemini
GEMINI_MODEL=gemini-1.5-flash

# Grok (Optional)
GROK_API_KEY=your_grok_api_key_if_using_grok
GROK_MODEL=grok-4.1-fast

# Ollama (Optional - local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=initium/law_model

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_if_using_openai
OPENAI_MODEL=gpt-4-turbo

# Cost Budget
AI_COST_BUDGET=500
