# Copie para .env e preencha. NUNCA comite o .env de verdade.

# Chave própria deste servidor — exigida em toda rota via header X-API-Key. Sem isso,
# qualquer um que descubra a URL/IP deste servidor na sua rede consegue ler e sobrescrever
# seus dados. Gere um valor aleatório, por exemplo: openssl rand -hex 32
API_KEY=

# Porta do servidor e origem liberada para CORS (o app web rodando localmente).
PORT=8788
ALLOWED_ORIGIN=http://localhost:5173

# Onde o banco.sqlite e o estado.json ficam salvos neste computador. Caminho relativo (à
# pasta sync-server) ou absoluto — se for rodar isso num NAS/Raspberry Pi permanente, aponte
# para um disco com backup próprio (ver README).
DADOS_DIR=./dados
