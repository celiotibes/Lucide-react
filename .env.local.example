# ============================================================================
# CRMT Gestão Imobiliária - Variáveis de Ambiente para DESENVOLVIMENTO LOCAL
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha os valores conforme seu ambiente local
# 3. NUNCA commite .env.local (arquivo já está no .gitignore)
# 4. Use durante desenvolvimento apenas
# ============================================================================

# ============================================================================
# 🗄️  DATABASE - Conexão PostgreSQL (CRÍTICO)
# ============================================================================
# Formato: postgres://usuario:senha@host:porta/banco
#
# Para Docker local (recomendado):
#   postgresql://crmt_user:crmt_senha_123@localhost:5432/crmt_db
#
# Para PostgreSQL instalado localmente:
#   postgresql://crmt_user:crmt_senha_123@localhost:5432/crmt_db
#
# Para Supabase Cloud:
#   Pegar em: Supabase Dashboard > Settings > Database > Connection string
#   (copiar a string PostgreSQL, não a string "Connection Pooler")
DATABASE_URL=postgresql://crmt_user:crmt_senha_123@localhost:5432/crmt_db

# ============================================================================
# 🔌 SUPABASE - Cliente para Auth, RLS e Realtime (OPCIONAL)
# ============================================================================
# Se usar Supabase Cloud (recomendado para staging/produção):
#
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Se usar Supabase Local (via supabase start):
#
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhkbmdsaGZla2NobmxkbmdsaGYiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYxNDI5NzAwMCwiZXhwIjoxOTI5ODczMDAwfQ.OjrKqWvHkpPvRHO8LVIGvTx6E6g4CrRxF8Q0CZ5Jb2U
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Se NÃO usar Supabase (apenas Postgres puro):
#   Deixe estes campos comentados - sistema funciona sem RLS

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhkbmdsaGZla2NobmxkbmdsaGYiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYxNDI5NzAwMCwiZXhwIjoxOTI5ODczMDAwfQ.OjrKqWvHkpPvRHO8LVIGvTx6E6g4CrRxF8Q0CZ5Jb2U
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhkbmdsaGZla2NobmxkbmdsaGYiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjE0Mjk3MDAwLCJleHAiOjE5Mjk4NzMwMDB9.Qmr5QzF5QvHq6v9T9Z9vQ8H5vR9T5vR9T5vR9T5vR9T

# ============================================================================
# 🤖 ANTHROPIC API - IA para análise de contratos e documentos
# ============================================================================
# Pegar em: https://console.anthropic.com/settings/keys
# Sem esta chave: funcionalidades de IA estarão desabilitadas (é ok para testes)
# Não compartilhe esta chave
ANTHROPIC_API_KEY=sk-ant-v0-seu-token-aqui

# ============================================================================
# 📧 EMAIL - Notificações automáticas (OPCIONAL)
# ============================================================================
# Destinatário dos avisos de:
# - Vencimento de contratos
# - Reequilíbrio trienal
# - Renovação de contrato
# - Multas (dia 30, 40, 60 de atraso)
EMAIL_ADMIN_NOTIFICACOES=admin@seu-dominio.com.br

# Provider de email (opcional):
# Se não configurar, sistema usa logs em vez de enviar emails
# Opções: resend, sendgrid, mailgun, etc
# RESEND_API_KEY=re_seu_token_aqui

# ============================================================================
# 🌐 NEXT.js - Configuração do servidor
# ============================================================================
# Porta padrão: 3000
# Se quiser mudar: NODE_PORT=3001
NODE_ENV=development

# ============================================================================
# 🔐 SEGURANÇA - JWT/Auth (OPCIONAL)
# ============================================================================
# Se usar autenticação custom:
# JWT_SECRET=sua-chave-secreta-muito-longa-e-aleatoria
# JWT_EXPIRE=24h

# ============================================================================
# 📊 ANALYTICS/BI (OPCIONAL)
# ============================================================================
# Se usar Metabase
# METABASE_URL=http://localhost:3000
# METABASE_KEY=sua-chave

# Se usar Posthog
# NEXT_PUBLIC_POSTHOG_KEY=sua-chave
# NEXT_PUBLIC_POSTHOG_HOST=http://localhost:3000

# ============================================================================
# 🔗 INTEGRAÇÕES EXTERNAS (OPCIONAL)
# ============================================================================

# Twilio - WhatsApp/SMS (notificações)
# TWILIO_ACCOUNT_SID=sua-conta
# TWILIO_AUTH_TOKEN=seu-token
# TWILIO_PHONE_NUMBER=+5541999999999

# Stripe - Pagamentos
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Google Maps - Localização de propriedades
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua-chave

# ============================================================================
# 🧪 DESENVOLVIMENTO - Flags e Debug
# ============================================================================
# Habilitar logs detalhados
DEBUG=crmt:*

# Modo strict (rejeita operações questionáveis)
# STRICT_MODE=true

# Seed inicial (para testes)
# SEED_DATABASE=true

# ============================================================================
# ⚡ PERFORMANCE (OPCIONAL)
# ============================================================================
# Max pool size para banco de dados
# DB_MAX_POOL_SIZE=20

# Cache em memória
# ENABLE_MEMORY_CACHE=true
# MEMORY_CACHE_TTL=3600  # segundos

# ============================================================================
# 📝 LOGGING (OPCIONAL)
# ============================================================================
# Níveis: debug, info, warn, error
# LOG_LEVEL=debug

# Arquivo de log
# LOG_FILE=./logs/app.log

# ============================================================================
# FIM - Variáveis de Desenvolvimento Local
# ============================================================================
# Próximo passo: npm install && npm run dev
# Dúvidas? Ver SETUP_LOCAL_COMPLETO.md
