# Development environment for testing
NODE_ENV=development

# Database
POSTGRES_USER=rental_user
POSTGRES_PASSWORD=rental_password
POSTGRES_DB=rental_sync
DATABASE_URL=postgresql://rental_user:rental_password@postgres:5432/rental_sync
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=dev-secret-key-for-testing
JWT_EXPIRATION=7d

# External APIs (dummy values for testing)
BOOKING_ACCOUNT_ID=test_account_123
BOOKING_API_KEY=test_key_123
BOOKING_WEBHOOK_SECRET=test_webhook_secret_123
VRBO_API_KEY=test_vrbo_key_123
VRBO_WEBHOOK_SECRET=test_vrbo_webhook_secret_123
STRIPE_API_KEY=sk_test_dummy_key
GEMINI_API_KEY=dummy_gemini_key

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend
VITE_API_URL=http://localhost:3000
