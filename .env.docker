# ===================================
# Docker Environment Configuration
# ===================================
# Copy this file to .env and customize for your Docker environment
# This template includes all required and optional variables

# ===================================
# CORE SERVER CONFIGURATION
# ===================================

# Environment: development | production | test
NODE_ENV=production

# Server Port (must match EXPOSE in Dockerfile and docker-compose.yml)
PORT=3000

# ===================================
# DATABASE CONFIGURATION
# ===================================
# SQLite (development/small deployments)
DATABASE_URL=file:./data/app.db

# PostgreSQL - Local/Development
# DATABASE_URL=postgresql://crmt:password@localhost:5432/crmt_dev

# PostgreSQL - AWS RDS Aurora
# DATABASE_URL=postgresql://crmt:password@crmt-db.cluster-xxx.us-east-1.rds.amazonaws.com:5432/crmt_prod
# DATABASE_REPLICA_URL=postgresql://crmt:password@crmt-db.cluster-ro-xxx.us-east-1.rds.amazonaws.com:5432/crmt_prod

# PostgreSQL - Azure Database
# DATABASE_URL=postgresql://crmt@crmt-db-prod:password@crmt-db-prod.postgres.database.azure.com:5432/crmt_prod?sslmode=require

# PostgreSQL - Google Cloud SQL (via Cloud SQL Proxy)
# DATABASE_URL=postgresql://crmt:password@localhost:5432/crmt_prod
# CLOUDSQL_PROXY_PATH=/usr/local/bin/cloud_sql_proxy
# CLOUDSQL_INSTANCE=my-project:us-central1:crmt-db-prod

# ===================================
# CONNECTION POOLING (Cloud Databases)
# ===================================
# Recommended for PostgreSQL in production
DATABASE_POOL_SIZE=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_CONNECTION_TIMEOUT=5000
DATABASE_POOL_MAX_OVERFLOW=5

# SSL/TLS (required for cloud databases)
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Read Replicas (optional, for load distribution)
# DATABASE_REPLICA_URL=postgresql://user:pass@replica-host:5432/dbname

# CORS allowed origin(s) — comma-separated for multiple domains
# Development: http://localhost:5173
# Production: https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173

# ===================================
# SECURITY (REQUIRED)
# ===================================

# API Key for backend authentication — must be at least 32 characters
# Generate: openssl rand -base64 24
API_KEY=your-secure-api-key-min-32-chars-generate-with-openssl

# Session secret — at least 32 characters for signed cookies
# Generate: openssl rand -base64 24
SESSION_SECRET=your-session-secret-min-32-chars-generate-with-openssl

# ===================================
# SETUP WIZARD - ENCRYPTION & CREDENTIALS (Phase 21)
# ===================================

# Master secret for AES-256-GCM credential encryption in Setup Wizard
# Used to encrypt sensitive fields: API keys, passwords, cloud credentials
# If not set, falls back to API_KEY (not recommended for production)
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_SECRET=

# ===================================
# BACKUP CONFIGURATION (Phase 21)
# ===================================

# Enable automated backups (true | false)
BACKUP_ENABLED=true

# Backup schedule in cron expression format (daily at 02:00 UTC)
# Format: "minute hour * * *" (cron-style: 0-59 0-23 * * *)
# Default: 0 2 * * * (daily at 02:00)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention period in days (default: 30)
# Old backups are automatically deleted after this period
BACKUP_RETENTION_DAYS=30

# ===================================
# INTEGRATIONS - ASAAS (Payments)
# ===================================

# Asaas API Key for PIX payment integration
# Get from: https://app.asaas.com/settings/api
ASAAS_API_KEY=

# Use sandbox (true) or production (false)
ASAAS_SANDBOX=true

# ===================================
# INTEGRATIONS - PLUGGY (Open Finance)
# ===================================

# Pluggy SDK credentials
# Get from: https://pluggy.ai/dashboard
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ===================================
# INTEGRATIONS - DIGITAL SIGNATURE
# ===================================

# CertSign API Key for digital signatures
# Get from: https://www.certsign.com.br/
CERTISIGN_API_KEY=

# Serproid API Key for additional services
SERPROID_API_KEY=

# ===================================
# NOTIFICATIONS - EMAIL
# ===================================

# Email provider: resend | sendgrid | none (default: none = disabled)
ALERTS_EMAIL_PROVIDER=none

# Email provider API key
# Resend: https://resend.com (free tier: 100/day)
# SendGrid: https://sendgrid.com (free tier: 100/day)
ALERTS_EMAIL_API_KEY=

# Sender email address
ALERTS_EMAIL_FROM=noreply@example.com

# Admin email(s) for alerts — comma-separated
ALERTS_EMAIL_TO_ADMIN=admin@example.com

# ===================================
# NOTIFICATIONS - SLACK
# ===================================

# Slack incoming webhook URL for alerts
# Setup: Slack Settings > Integrations > Incoming Webhooks > Add to workspace
SLACK_WEBHOOK_URL=

# ===================================
# NOTIFICATIONS - TELEGRAM
# ===================================

# Telegram Bot Token for quick document capture
# Create bot: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Bot Username (public, goes in VITE_ variables)
VITE_TELEGRAM_BOT_USERNAME=

# ===================================
# MONITORING - SENTRY
# ===================================

# Sentry DSN for error tracking in production
# Get from: https://sentry.io
SENTRY_DSN=

# Sentry environment: development | staging | production
SENTRY_ENVIRONMENT=development

# ===================================
# CLOUD PROVIDER INTEGRATION (Phase 21)
# ===================================

# AWS S3 Backup Configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=crmt-backups-prod
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/xxxxxxxx

# Azure Blob Storage Backup Configuration
# AZURE_STORAGE_ACCOUNT=crmtbackups
# AZURE_STORAGE_KEY=...
# AZURE_BACKUP_CONTAINER=backups

# ===================================
# BACKUP - GOOGLE DRIVE & CLOUD STORAGE
# ===================================

# Google Service Account JSON credentials (full multi-line JSON)
# Setup: https://cloud.google.com/docs/authentication/getting-started
# 1. Create Service Account in Google Cloud Console
# 2. Generate JSON key
# 3. Paste entire JSON here (with \n for newlines)
GOOGLE_CREDENTIALS_JSON=

# Google Cloud Storage (GCS) Backup Configuration
# GCS_BUCKET=crmt-backups-prod
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ===================================
# AI - ANTHROPIC CLAUDE API (Client-side)
# ===================================

# Claude API key for automatic document classification
# Get from: https://console.anthropic.com
# WARNING: This is exposed in frontend bundle — use backend endpoint for sensitive data
VITE_ANTHROPIC_API_KEY=

# ===================================
# CLASSIFICATION BACKEND (Recommended)
# ===================================

# Backend endpoint for document classification
# If set, client will use this instead of VITE_ANTHROPIC_API_KEY
# Format: https://your-backend.com/api/classify
VITE_CLASIFICACAO_BACKEND=

# ===================================
# CACHE CONFIGURATION
# ===================================

# Report cache TTLs in milliseconds (0 = disabled)

# DRE (Income Statement) cache TTL — default: 1 hour
CACHE_TTL_DRE=3600000

# Cash Flow cache TTL — default: 2 hours
CACHE_TTL_FLUXO=7200000

# Margins cache TTL — default: 2 hours
CACHE_TTL_MARGENS=7200000

# Reconciliation cache TTL — default: 30 minutes
CACHE_TTL_RECONCILIACAO=1800000

# ===================================
# LOG CONFIGURATION
# ===================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# ===================================
# DEVELOPMENT HELPERS
# ===================================

# Enable CORS in development (auto-enabled if NODE_ENV=development)
DEBUG_CORS=false

# Show raw SQL queries (development only)
DEBUG_SQL=false
