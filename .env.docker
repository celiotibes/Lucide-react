# ===================================
# Docker Environment Configuration
# ===================================
# Copy this file to .env and customize for your Docker environment
# This template includes all required and optional variables

# ===================================
# CORE SERVER CONFIGURATION
# ===================================

# Environment: development | production | test
NODE_ENV=development

# Server Port (must match EXPOSE in Dockerfile)
PORT=8787

# Database URL — SQLite path or PostgreSQL connection string
# SQLite: file:./data/lucide.sqlite
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=file:./data/lucide.sqlite

# CORS allowed origin(s) — comma-separated for multiple domains
# Development: http://localhost:5173
# Production: https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173

# ===================================
# SECURITY (REQUIRED)
# ===================================

# API Key for backend authentication — must be at least 32 characters
# Generate: openssl rand -base64 24
API_KEY=your-secure-api-key-min-32-chars-generate-with-openssl

# Session secret — at least 32 characters for signed cookies
# Generate: openssl rand -base64 24
SESSION_SECRET=your-session-secret-min-32-chars-generate-with-openssl

# ===================================
# INTEGRATIONS - ASAAS (Payments)
# ===================================

# Asaas API Key for PIX payment integration
# Get from: https://app.asaas.com/settings/api
ASAAS_API_KEY=

# Use sandbox (true) or production (false)
ASAAS_SANDBOX=true

# ===================================
# INTEGRATIONS - PLUGGY (Open Finance)
# ===================================

# Pluggy SDK credentials
# Get from: https://pluggy.ai/dashboard
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ===================================
# INTEGRATIONS - DIGITAL SIGNATURE
# ===================================

# CertSign API Key for digital signatures
# Get from: https://www.certsign.com.br/
CERTISIGN_API_KEY=

# Serproid API Key for additional services
SERPROID_API_KEY=

# ===================================
# NOTIFICATIONS - EMAIL
# ===================================

# Email provider: resend | sendgrid | none (default: none = disabled)
ALERTS_EMAIL_PROVIDER=none

# Email provider API key
# Resend: https://resend.com (free tier: 100/day)
# SendGrid: https://sendgrid.com (free tier: 100/day)
ALERTS_EMAIL_API_KEY=

# Sender email address
ALERTS_EMAIL_FROM=noreply@example.com

# Admin email(s) for alerts — comma-separated
ALERTS_EMAIL_TO_ADMIN=admin@example.com

# ===================================
# NOTIFICATIONS - SLACK
# ===================================

# Slack incoming webhook URL for alerts
# Setup: Slack Settings > Integrations > Incoming Webhooks > Add to workspace
SLACK_WEBHOOK_URL=

# ===================================
# NOTIFICATIONS - TELEGRAM
# ===================================

# Telegram Bot Token for quick document capture
# Create bot: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Bot Username (public, goes in VITE_ variables)
VITE_TELEGRAM_BOT_USERNAME=

# ===================================
# MONITORING - SENTRY
# ===================================

# Sentry DSN for error tracking in production
# Get from: https://sentry.io
SENTRY_DSN=

# Sentry environment: development | staging | production
SENTRY_ENVIRONMENT=development

# ===================================
# BACKUP - GOOGLE DRIVE
# ===================================

# Google Service Account JSON credentials (full multi-line JSON)
# Setup: https://cloud.google.com/docs/authentication/getting-started
# 1. Create Service Account in Google Cloud Console
# 2. Generate JSON key
# 3. Paste entire JSON here (with \n for newlines)
GOOGLE_CREDENTIALS_JSON=

# ===================================
# AI - ANTHROPIC CLAUDE API (Client-side)
# ===================================

# Claude API key for automatic document classification
# Get from: https://console.anthropic.com
# WARNING: This is exposed in frontend bundle — use backend endpoint for sensitive data
VITE_ANTHROPIC_API_KEY=

# ===================================
# CLASSIFICATION BACKEND (Recommended)
# ===================================

# Backend endpoint for document classification
# If set, client will use this instead of VITE_ANTHROPIC_API_KEY
# Format: https://your-backend.com/api/classify
VITE_CLASIFICACAO_BACKEND=

# ===================================
# CACHE CONFIGURATION
# ===================================

# Report cache TTLs in milliseconds (0 = disabled)

# DRE (Income Statement) cache TTL — default: 1 hour
CACHE_TTL_DRE=3600000

# Cash Flow cache TTL — default: 2 hours
CACHE_TTL_FLUXO=7200000

# Margins cache TTL — default: 2 hours
CACHE_TTL_MARGENS=7200000

# Reconciliation cache TTL — default: 30 minutes
CACHE_TTL_RECONCILIACAO=1800000

# ===================================
# LOG CONFIGURATION
# ===================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# ===================================
# DEVELOPMENT HELPERS
# ===================================

# Enable CORS in development (auto-enabled if NODE_ENV=development)
DEBUG_CORS=false

# Show raw SQL queries (development only)
DEBUG_SQL=false
