# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details

# === Development Environment ===
REACT_APP_FIREBASE_API_KEY=your_dev_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-dev.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-dev
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-dev.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_dev_messaging_id
REACT_APP_FIREBASE_APP_ID=your_dev_app_id
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-dev.firebaseio.com

# === Firebase Emulator (Development Only) ===
REACT_APP_USE_FIREBASE_EMULATOR=true

# === Encryption Key (for sensitive data) ===
# Generate with: openssl rand -base64 32
REACT_APP_ENCRYPTION_KEY=your_encryption_key_here

# === Feature Flags ===
REACT_APP_ENABLE_2FA=true
REACT_APP_ENABLE_EMAIL_VERIFICATION=true
REACT_APP_REQUIRE_HTTPS=false
REACT_APP_SESSION_TIMEOUT_MINUTES=60

# === Rate Limiting ===
REACT_APP_RATE_LIMIT_READ=1000
REACT_APP_RATE_LIMIT_WRITE=100
REACT_APP_RATE_LIMIT_UPLOAD=10

# === API Configuration ===
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_API_TIMEOUT_MS=30000

# === Logging ===
REACT_APP_LOG_LEVEL=debug
REACT_APP_SENTRY_DSN=

# === Cloud Function URLs (for development) ===
REACT_APP_VALIDATE_USER_ENDPOINT=http://localhost:5001/lucide-react-dev/us-central1/validateUserCreate
REACT_APP_RATE_LIMIT_ENDPOINT=http://localhost:5001/lucide-react-dev/us-central1/checkRateLimit

# === Security Settings ===
REACT_APP_CORS_ENABLED=true
REACT_APP_ENFORCE_SSL=false

# === Backup Settings ===
REACT_APP_AUTO_BACKUP_ENABLED=true
REACT_APP_BACKUP_RETENTION_DAYS=30

# === Monitoring ===
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# ===================================================
# === PRODUCTION ENVIRONMENT - NEVER COMMIT THESE ===
# ===================================================

# Replace these with actual production values
# REACT_APP_FIREBASE_API_KEY=prod_api_key
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your-project-prod
# REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-prod.appspot.com
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=prod_messaging_id
# REACT_APP_FIREBASE_APP_ID=prod_app_id
# REACT_APP_FIREBASE_DATABASE_URL=https://your-project-prod.firebaseio.com

# Production Encryption Key (generate new secure key)
# REACT_APP_ENCRYPTION_KEY=production_encryption_key

# Production Settings
# REACT_APP_USE_FIREBASE_EMULATOR=false
# REACT_APP_SESSION_TIMEOUT_MINUTES=30
# REACT_APP_REQUIRE_HTTPS=true
# REACT_APP_LOG_LEVEL=info
# REACT_APP_ENFORCE_SSL=true
