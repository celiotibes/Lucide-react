# Copie para .env e preencha. NUNCA comite o .env de verdade.
# Gere/gerencie estas credenciais em https://dashboard.pluggy.ai
CLIENT_ID=
CLIENT_SECRET=

# Chave própria deste backend (não é da Pluggy) — exigida em toda rota via header
# X-API-Key. Sem isso, qualquer um que descubra a URL pública deste servidor (ex: hospedado
# no Render) consegue ler seus extratos bancários sem credencial nenhuma. Gere um valor
# aleatório, por exemplo: openssl rand -hex 32
API_KEY=

# Porta do backend e origem liberada para CORS (o app web rodando localmente)
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Segredo usado para assinar (HMAC-SHA256) o token de sessão de login
# (POST /api/auth/login). Se não for definido, o servidor GERA um segredo
# aleatório só para aquele processo e avisa alto no log — funciona para
# testar localmente, mas TODAS as sessões caem a cada restart, e réplicas
# diferentes do servidor não reconhecem o token uma da outra. Gere um valor
# fixo antes de hospedar isto de verdade, por exemplo: openssl rand -hex 32
SESSION_SECRET=

# --- Asaas (emissão de boleto/PIX) — opcional, só necessário ao emitir cobrança ---
# Gere em https://www.asaas.com (ou o ambiente sandbox: https://sandbox.asaas.com)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Header "asaas-access-token" que a Asaas deve mandar no webhook de confirmação de
# pagamento. Opcional em dev/sandbox (aceita sem validar, com aviso no log).
ASAAS_WEBHOOK_TOKEN=

# --- MeuPluggy (sincronização bancária pessoal, uso gratuito) — opcional ---
# Credenciais PRÓPRIAS geradas em https://dashboard.pluggy.ai depois de conectar
# suas contas em https://meu.pluggy.ai — DIFERENTES de CLIENT_ID/CLIENT_SECRET
# acima (aquelas são do fluxo comercial via widget, estas são do uso pessoal).
PLUGGY_MEU_CLIENT_ID=
PLUGGY_MEU_CLIENT_SECRET=
# IDs dos Items conectados em meu.pluggy.ai, separados por vírgula (a API da
# Pluggy não lista Items por credencial — precisa informar cada um aqui).
PLUGGY_MEU_ITEM_IDS=

# --- Bot do Telegram (captura rápida de documentos + notificações) — opcional ---
# Token gerado pelo @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=
# Precisa ser o MESMO valor passado em "secret_token" ao configurar o webhook do
# bot (chamada setWebhook da API do Telegram) — valida que a requisição em
# /api/telegram/webhook realmente veio do Telegram.
TELEGRAM_WEBHOOK_SECRET=

# --- Notificações por e-mail (SMTP) — opcional, só necessário ao disparar notificação ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nome do remetente <email@exemplo.com>"

# --- Notificações por WhatsApp (Meta WhatsApp Cloud API) — opcional ---
# Gere em https://developers.facebook.com (produto WhatsApp)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
