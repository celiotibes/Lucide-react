{
  "name": "rental-sync-backend",
  "version": "1.0.0",
  "description": "Multi-channel vacation rental synchronization platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx node_modules/vitest/vitest.mjs",
    "migrate": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "sync:booking": "tsx src/workers/booking-calendar-sync.ts",
    "sync:vrbo": "tsx src/workers/vrbo-calendar-sync.ts",
    "process:ai": "tsx src/workers/ai-task-processor.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "bullmq": "^5.1.4",
    "dotenv": "^16.3.1",
    "axios": "^1.6.5",
    "stripe": "^14.9.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "xmlrpc": "^1.3.2",
    "cors": "^2.8.5",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "vitest": "^1.1.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
