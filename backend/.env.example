# Backend Configuration
# Copy to .env and update values

# Environment
ENVIRONMENT=development
DEBUG=true

# API Port
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lucide_react_db
# Para produção:
# DATABASE_URL=postgresql://user:password@prod-db.rds.amazonaws.com:5432/lucide

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Claude API (IA)
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-opus-4-8

# Pinecone (RAG - FASE 4C)
# Criar conta em: https://www.pinecone.io/
PINECONE_API_KEY=xxxxx
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=lucide-jurisprudencia
PINECONE_DIMENSION=384  # Para all-MiniLM-L6-v2 embeddings

# Embeddings Model
# sentence-transformers/all-MiniLM-L6-v2 (384 dims, rápido)
# sentence-transformers/all-mpnet-base-v2 (768 dims, mais preciso)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Serviços Externos - CNJ/Tribunais
CNJ_PORTAL_URL=https://www.cnj.jus.br/api/publico
MNI_API_URL=https://mni.cnj.jus.br/api/v1
CERTIFICADO_DIGITAL_PATH=/path/to/certificado.p12
CERTIFICADO_DIGITAL_SENHA=xxx

# Google Drive (Futuro - FASE 4D+)
GOOGLE_DRIVE_API_KEY=xxx
GOOGLE_DRIVE_FOLDER_ID=xxx

# Monitoring (Opcional)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Legal Data Hunter (Futuro)
LEGAL_DATA_HUNTER_API_KEY=xxx

# Logs
LOG_LEVEL=INFO
