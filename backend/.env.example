# Application Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/rental_sync
DATABASE_POOL_SIZE=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_MS=600000

# Redis Configuration (BullMQ Queue)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Booking.com Integration
BOOKING_API_KEY=your-booking-api-key
BOOKING_ACCOUNT_ID=your-booking-account-id
BOOKING_WEBHOOK_SECRET=your-booking-webhook-secret

# Airbnb Integration
AIRBNB_API_KEY=your-airbnb-api-key
AIRBNB_WEBHOOK_SECRET=your-airbnb-webhook-secret

# VRBO Integration
VRBO_API_KEY=your-vrbo-api-key
VRBO_WEBHOOK_SECRET=your-vrbo-webhook-secret

# Gemini AI Integration (for lead management and pricing recommendations)
GEMINI_API_KEY=your-gemini-api-key

# Staging Environment Configuration
STAGING_DATABASE_URL=postgresql://username:password@staging-db.example.com:5432/rental_sync_staging
STAGING_REDIS_URL=redis://staging-redis.example.com:6379
STAGING_API_BASE_URL=https://api-staging.example.com

# Production Environment Configuration
PRODUCTION_DATABASE_URL=postgresql://username:password@prod-db.example.com:5432/rental_sync
PRODUCTION_REDIS_URL=redis://prod-redis.example.com:6379
PRODUCTION_API_BASE_URL=https://api.example.com

# Logging Configuration
LOG_FORMAT=json
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG
LOG_FILE_PATH=/var/log/rental-sync/app.log

# Worker Configuration (BullMQ)
WORKER_CONCURRENCY_SYNC_LISTINGS=5
WORKER_CONCURRENCY_PRICING=3
WORKER_CONCURRENCY_LEAD_MANAGEMENT=10
WORKER_MAX_ATTEMPTS_SYNC=3
WORKER_MAX_ATTEMPTS_PRICING=2
WORKER_BACKOFF_STRATEGY=exponential
WORKER_BACKOFF_DELAY_MS=2000

# Performance Configuration
CACHE_TTL_PROPERTY_DASHBOARD=300000
CACHE_TTL_LISTING_PERFORMANCE=600000
CACHE_TTL_PRICING_ANALYSIS=900000
QUERY_TIMEOUT_MS=30000

# Feature Flags
ENABLE_DYNAMIC_PRICING=true
ENABLE_AI_LEAD_SCORING=true
ENABLE_REAL_TIME_SYNC=false
ENABLE_DETAILED_LOGGING=false

# Monitoring and Alerting
SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
ALERT_EMAIL=admin@example.com

# Testing Configuration
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/rental_sync_test
TEST_MODE=false
TEST_TIMEOUT_MS=30000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true
