# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rental_sync
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# Booking.com
BOOKING_ACCOUNT_ID=your_booking_account_id
BOOKING_API_KEY=your_booking_api_key
BOOKING_USERNAME=your_booking_username
BOOKING_PASSWORD=your_booking_password
BOOKING_WEBHOOK_SECRET=your_booking_webhook_secret

# VRBO
VRBO_API_KEY=your_vrbo_api_key
VRBO_WEBHOOK_SECRET=your_vrbo_webhook_secret

# Stripe
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CloudWatch (Optional - for logging)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
CLOUDWATCH_LOG_GROUP=/rental-sync/backend
CLOUDWATCH_LOG_STREAM=production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
