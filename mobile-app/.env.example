# Environment Variables Template
# Copy this file to .env.development, .env.preview, or .env.production
# Fill in the actual values for your environment

# API Configuration
API_ENDPOINT=http://localhost:8000
API_TIMEOUT=30000

# Firebase Configuration (get from Firebase Console)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abcd1234efgh5678

# Analytics
ANALYTICS_ENABLED=true
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# App Configuration
APP_NAME=CRMT Mobile
BUILD_TYPE=development
DEBUG=true
LOG_LEVEL=debug

# Feature Flags
FEATURE_OFFLINE_MODE=true
FEATURE_DOCUMENT_OCR=true
FEATURE_BATCH_UPLOAD=true
FEATURE_ADVANCED_FILTERS=true

# Versioning (auto-managed by release scripts)
APP_VERSION=0.1.0
BUILD_NUMBER=1

# EAS Build Configuration
EAS_PROFILE=development
EAS_CHANNEL=development
