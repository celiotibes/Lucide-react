# Android Gradle Configuration for Lucide React Mobile Application
# Security Hardening & Build Configuration
# Copy to gradle.properties and fill in your values

# ============================================================================
# Build Configuration
# ============================================================================
org.gradle.jvmargs=-Xmx4096m -XX:MaxPermSize=2048m
org.gradle.parallel=true
org.gradle.daemon=true
org.gradle.caching=true

# ============================================================================
# SDK Versions
# ============================================================================
# SDK target version must be 34 or higher for App Store compliance
android.targetSdkVersion=34
android.minSdkVersion=24
android.compileSdkVersion=34

# ============================================================================
# Security: Cleartext Traffic Policy
# ============================================================================
# Disable cleartext traffic (enforce HTTPS only)
android.enableCleartextTraffic=false

# ============================================================================
# Security: Signing Configuration
# ============================================================================
# Release signing configuration
KEYSTORE_FILE=crmt-keystore.jks
KEYSTORE_PASSWORD=your-secure-keystore-password
KEY_ALIAS=crmt-key
KEY_PASSWORD=your-secure-key-password

# Debug signing (for development only)
DEBUG_KEYSTORE_FILE=debug.keystore
DEBUG_KEYSTORE_PASSWORD=android
DEBUG_KEY_ALIAS=androiddebugkey
DEBUG_KEY_PASSWORD=android

# ============================================================================
# Security: ProGuard / R8 Configuration
# ============================================================================
# Enable code obfuscation for release builds
android.enableR8=true
android.enableProguard=true

# Minify and obfuscate
android.enableMinificationInReleaseBuilds=true

# Use Zipalign for optimization
android.enableZipalign=true

# ============================================================================
# Security: Build Features
# ============================================================================
# Disable unused features to reduce attack surface
android.useAndroidX=true
android.enableJetifier=true

# Enable StrictMode for development (catch threading issues)
android.strictMode=true

# ============================================================================
# Security: Version Configuration
# ============================================================================
# Application version
VERSION_NAME=1.0.0
VERSION_CODE=1

# Namespace (unique identifier)
PACKAGE_NAME=com.crmt.mobile
APPLICATION_ID=com.crmt.mobile

# ============================================================================
# Security: Native Code Configuration
# ============================================================================
# Enable native debugging symbols for crash reporting
# But obfuscate symbols in release builds
android.debuggable=false

# Support for native code architectures
ANDROID_ABI_FILTERS=arm64-v8a,armeabi-v7a

# ============================================================================
# Security: Data Encryption Configuration
# ============================================================================
# Encryption algorithm (from app security configuration)
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_BITS=256
ENCRYPTION_ITERATIONS=100000

# ============================================================================
# Security: Certificate Pinning Configuration
# ============================================================================
# API domain for certificate pinning
API_DOMAIN=api.crmt.app
API_DOMAIN_BACKUP=backup-api.crmt.app

# Certificate pins (SHA-256 hashes of public keys)
API_CERT_PIN=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BACKUP_API_CERT_PIN=sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# ============================================================================
# Security: TLS Configuration
# ============================================================================
# Minimum TLS version (TLS 1.3 preferred, TLS 1.2 minimum)
TLS_MIN_VERSION=1.3
TLS_CIPHER_SUITES=TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256,TLS_CHACHA20_POLY1305_SHA256

# ============================================================================
# Security: Permissions Configuration
# ============================================================================
# Required permissions (defined in AndroidManifest.xml)
REQUIRED_PERMISSIONS=INTERNET,ACCESS_NETWORK_STATE,CAMERA,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE

# Dangerous permissions (require user consent)
DANGEROUS_PERMISSIONS=CAMERA,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE

# ============================================================================
# Security: Hardening Options
# ============================================================================
# Enable ASLR (Address Space Layout Randomization)
android.enableAslr=true

# Enable DEP/NX (Data Execution Prevention)
android.enableDep=true

# Enable PIE (Position Independent Executable)
android.enablePie=true

# ============================================================================
# Firebase Configuration
# ============================================================================
# Firebase project configuration
FIREBASE_PROJECT_ID=crmt-mobile
FIREBASE_API_KEY=AIzaSyD...your_firebase_key...
FIREBASE_APP_ID=1:123456789:android:abc123def456

# Enable Firebase Crashlytics
FIREBASE_CRASHLYTICS_ENABLED=true

# ============================================================================
# Privacy & Compliance Configuration
# ============================================================================
# GDPR Compliance
GDPR_ENABLED=true
GDPR_TRACKING_ENABLED=true

# CCPA Compliance (California)
CCPA_ENABLED=true

# LGPD Compliance (Brazil)
LGPD_ENABLED=true

# ============================================================================
# Release Build Configuration
# ============================================================================
# Release build properties
RELEASE_BUILD_TYPE=release
RELEASE_BUILD_FLAVOR=production

# Debugging disabled in release
android.debuggable=false

# Crash reporting enabled
CRASH_REPORTING_ENABLED=true

# Analytics enabled
ANALYTICS_ENABLED=true

# ============================================================================
# Development Build Configuration
# ============================================================================
# Debug build properties
DEBUG_BUILD_TYPE=debug
DEBUG_BUILD_FLAVOR=development

# Debugging enabled in debug builds
android.debuggable=true

# Mock API responses (for testing)
MOCK_API_RESPONSES=false

# ============================================================================
# NDK Configuration (if using native code)
# ============================================================================
# NDK version
NDK_VERSION=25.1.8937393

# ABI filters for native libraries
ABI_FILTERS=arm64-v8a,armeabi-v7a

# ============================================================================
# Kotlin Configuration
# ============================================================================
# Kotlin version compatibility
kotlin.jvmTarget=11
kotlin.incremental=true

# ============================================================================
# Notes & Warnings
# ============================================================================
# CRITICAL SECURITY NOTES:
# 1. Never commit this file with actual keystore passwords to version control
# 2. Use environment variables for sensitive values in CI/CD
# 3. Store keystore file securely (not in repo)
# 4. Rotate keys annually per security best practices
# 5. Keep dependencies updated for security patches
# 6. Run security scanning regularly (npm audit, dependency-check)
# 7. Test on multiple Android versions (API 24, 28, 33, 34)
# 8. Verify certificate pinning on real devices
# 9. Test encryption/decryption with different devices
# 10. Monitor for uncaught exceptions and crashes
