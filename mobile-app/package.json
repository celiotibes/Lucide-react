{
  "name": "crmt-mobile",
  "version": "0.1.0",
  "description": "CRMT Mobile App - Expo/React Native Android application",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo export:web",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "submit": "eas submit --platform android",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html",
    "test:unit": "jest --testPathPattern='(?!.*integration)' --coverage",
    "test:integration": "jest --testPathPattern='integration' --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "detox test --configuration android.emu.release --cleanup",
    "test:e2e:ios": "detox test --configuration ios.sim.release --cleanup",
    "test:e2e:build": "detox build-framework-cache && detox build-app --configuration android.emu.release",
    "test:e2e:build:ios": "detox build-framework-cache && detox build-app --configuration ios.sim.release",
    "test:e2e:local": "detox test --configuration android.emu.debug --record-logs all",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:report": "node scripts/generate-coverage-report.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "echo 'Database migrations handled by WatermelonDB'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "expo": "^51.0.0",
    "expo-constants": "^16.0.0",
    "expo-secure-store": "^13.0.0",
    "expo-sqlite": "^14.0.0",
    "expo-camera": "^14.0.0",
    "expo-image-picker": "^14.0.0",
    "expo-media-library": "^15.0.0",
    "expo-file-system": "^16.0.0",
    "expo-sharing": "^12.0.0",
    "expo-document-picker": "^11.0.0",
    "expo-image-manipulator": "^11.0.0",
    "expo-permissions": "^14.0.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-paper": "^5.10.0",
    "react-native-vector-icons": "^10.0.0",
    "@react-native-community/async-storage": "^1.12.1",
    "@react-native-firebase/app": "^18.5.0",
    "@react-native-firebase/messaging": "^18.5.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0",
    "watermelondb": "^0.29.0",
    "@nozbe/watermelondb": "^0.29.0",
    "lodash": "^4.17.21",
    "date-fns": "^3.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react-native": "^12.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@babel/preset-typescript": "^7.23.0",
    "@types/jest": "^29.5.0",
    "jest-mock-extended": "^3.0.0",
    "ts-jest": "^29.1.0",
    "detox": "^20.13.0",
    "detox-cli": "^20.13.0",
    "nyc": "^15.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  }
}
