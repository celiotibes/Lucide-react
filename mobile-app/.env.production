# Production Environment Variables
# DO NOT COMMIT ACTUAL SECRETS - Use GitHub Actions or secure CI/CD secrets

# API Configuration
API_ENDPOINT=https://api.crmt.app
API_TIMEOUT=30000

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=crmt-prod.firebaseapp.com
FIREBASE_PROJECT_ID=crmt-prod
FIREBASE_STORAGE_BUCKET=crmt-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Analytics
ANALYTICS_ENABLED=true
SENTRY_DSN=

# App Configuration
APP_NAME=CRMT Mobile
BUILD_TYPE=production
DEBUG=false
LOG_LEVEL=error

# Feature Flags
FEATURE_OFFLINE_MODE=true
FEATURE_DOCUMENT_OCR=true
FEATURE_BATCH_UPLOAD=true
FEATURE_ADVANCED_FILTERS=true

# Versioning
APP_VERSION=1.0.0
BUILD_NUMBER=1
