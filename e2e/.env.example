# E2E Test Configuration
# Copy this file to .env.local and fill in your test credentials

# API Configuration
API_ENDPOINT=http://localhost:3000
SECURITY_ENDPOINT=https://api.example.com/security
GDPR_ENDPOINT=http://localhost:3000/api/gdpr

# Test User 1 Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=SecurePass123!@#
TEST_USER_CPF=12345678901

# Test User 2 Credentials (for multi-user tests)
TEST_USER2_EMAIL=test2@example.com
TEST_USER2_PASSWORD=SecurePass456!@#
TEST_USER2_CPF=98765432101

# Security Configuration
PINNED_DOMAIN=api.example.com

# Testing Mode
# Set to 'true' to use mock data instead of real API
MOCK_MODE=false

# Device Configuration
DEVICE_OS=android
DEVICE_VERSION=33

# Timeout Configuration (in milliseconds)
ACTION_TIMEOUT=5000
ELEMENT_TIMEOUT=10000
NETWORK_TIMEOUT=15000
SECURITY_TIMEOUT=20000

# Performance Thresholds (in milliseconds)
MAX_LOGIN_TIME=10000
MAX_RENDER_TIME=3000
MAX_ACTION_TIME=2000
MAX_NETWORK_LATENCY=5000

# Logging
DEBUG=false
VERBOSE=false
LOG_LEVEL=info

# Artifacts
ARTIFACTS_DIR=./artifacts/e2e
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
COLLECT_LOGS=true

# CI/CD
CI=false
CI_PROVIDER=github
CI_COMMIT_SHA=local
CI_BRANCH=develop

# Report Generation
GENERATE_COVERAGE=true
GENERATE_JUNIT_REPORT=true
UPLOAD_TO_CODECOV=false

# Security Testing
XSS_PAYLOAD=<script>alert("XSS")</script>
SQL_PAYLOAD=' OR '1'='1
ENCRYPTION_TEST_KEY=test-encryption-key-32-chars-here

# Data Retention Policy (days)
DATA_RETENTION_DAYS=30

# Privacy Settings
GDPR_COMPLIANCE_CHECK=true
CCPA_COMPLIANCE_CHECK=true
LGPD_COMPLIANCE_CHECK=true

# Email Configuration (for GDPR notification testing)
EMAIL_SERVICE_PROVIDER=sendgrid
EMAIL_API_KEY=your-email-service-api-key

# Biometric Testing
TEST_BIOMETRIC=true
BIOMETRIC_TYPE=fingerprint

# Timezone (for date-based tests)
TEST_TIMEZONE=America/Sao_Paulo
