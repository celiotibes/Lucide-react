{
  "name": "crmt-historico-contabil-financeiro",
  "description": "CRMT - Gestão Contábil & Financeira",
  "author": "CRMT Team <team@crmt.app>",
  "private": true,
  "version": "1.0.0",
  "main": "electron.cjs",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.lucidereact.crmt",
    "productName": "CRMT - Gestão Imobiliária",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "electron.cjs",
      "preload.cjs",
      "dist/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron.cjs"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/crmt-icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/crmt-icon-512.png",
      "uninstallerIcon": "assets/crmt-icon-512.png"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node create-electron-files.cjs",
    "build:typecheck": "tsc -b && vite build && node create-electron-files.cjs",
    "copy:electron-main": "node create-electron-files.cjs",
    "build:electron": "npm run build && electron-builder -m --publish=never",
    "build:electron:publish": "npm run build && electron-builder -m --publish=always",
    "build:windows": "npm run build && electron-builder -w --publish=never",
    "build:windows:publish": "npm run build && electron-builder -w --publish=always",
    "build:all": "npm run build && electron-builder -mw --publish=never",
    "build:all:publish": "npm run build && electron-builder -mw --publish=always",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "verificar-backup": "tsx scripts/verificar-backup.ts",
    "backup:enviar": "tsx scripts/backup/enviar-backup.ts",
    "backup:verificar-remoto": "tsx scripts/backup/verificar-remoto.ts",
    "backup:listar": "tsx scripts/backup/listar-backups.ts",
    "backup:restaurar": "tsx scripts/backup/restore-backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@sentry/node": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "archiver": "^7.0.1",
    "date-fns": "^3.0.0",
    "dotenv": "^18.0.5",
    "express": "^4.19.0",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.4.1",
    "fs-extra": "^11.2.0",
    "fuse.js": "^7.0.0",
    "googleapis": "^182.0.0",
    "idb-keyval": "^6.2.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "node-cron": "^4.6.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.1.200",
    "pluggy-connect-sdk": "^2.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^18.2.0",
    "recharts": "^3.9.2",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.1",
    "tar": "^7.5.22",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.9",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.1.2",
    "better-sqlite3": "^9.6.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
